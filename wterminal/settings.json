//
//  For Windows Terminal
//
//  Setup:
//      Install oh-my-posh via winget (run in PowerShell):
//          $ winget install JanDeDobbeleer.OhMyPosh -s winget
//
//      Install PSReadLine and posh-git via PowerShell modules:
//          $ Install-Module posh-git -Scope CurrentUser
//          $ Install-Module -Name PSReadLine -Scope CurrentUser -Force -SkipPublisherCheck
//
//      Open powershell profile by running:
//          $ notepad $profile
//
//      Copy the following to the profile file:
//          Import-Module posh-git
//          oh-my-posh init pwsh --config "$env:POSH_THEMES_PATH\agnoster.omp.json" | Invoke-Expression
//          cls
//
//      Download the Jet Brains Mono Font:
//          https://github.com/ryanoasis/nerd-fonts/tree/master/patched-fonts/JetBrainsMono
//
//      Copy this settings.json file into the systems settings.json file
{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [
        {
            "command": {
                "action": "setColorScheme",
                "colorScheme": "Gruvbox Dark"
            },
            "id": "User.setColorScheme.10000000"
        },
        {
            "command": {
                "action": "setColorScheme",
                "colorScheme": "Gruvbox Light"
            },
            "id": "User.setColorScheme.10000001"
        },
        {
            "command": {
                "action": "setColorScheme",
                "colorScheme": "Apple Classic"
            },
            "id": "User.setColorScheme.10000002"
        },
        {
            "command": {
                "action": "setColorScheme",
                "colorScheme": "VibrantTom"
            },
            "id": "User.setColorScheme.10000003"
        },
        {
            "command": {
                "action": "setColorScheme",
                "colorScheme": "One Dark"
            },
            "id": "User.setColorScheme.10000004"
        },
        {
            "command": {
                "action": "setColorScheme",
                "colorScheme": "One Light"
            },
            "id": "User.setColorScheme.10000005"
        },
        {
            "command": {
                "action": "newTab"
            },
            "id": "User.newTab"
        },
        {
            "command": {
                "action": "newTab",
                "index": 0
            },
            "id": "User.newTab.10000006"
        },
        {
            "command": {
                "action": "newTab",
                "index": 1
            },
            "id": "User.newTab.10000007"
        },
        {
            "command": {
                "action": "newTab",
                "index": 2
            },
            "id": "User.newTab.10000008"
        },
        {
            "command": {
                "action": "closeTab"
            },
            "id": "User.closeTab"
        },
        {
            "command": "closeWindow",
            "id": "User.closeWindow"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "auto",
                "splitMode": "duplicate"
            },
            "id": "User.splitPane.10000009"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "vertical",
                "splitMode": "duplicate"
            },
            "id": "User.splitPane.1000000A"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "horizontal",
                "splitMode": "duplicate"
            },
            "id": "User.splitPane.1000000B"
        },
        {
            "command": "closePane",
            "id": "User.closePane"
        },
        {
            "command": {
                "action": "openSettings",
                "target": "settingsFile"
            },
            "id": "User.openSettings.1000000C"
        }
    ],
    "centerOnLaunch": true,
    "copyOnSelect": true,
    "defaultProfile": "{00000000-0000-0000-0000-000000000001}",
    "initialCols": 120,
    "initialPosition": "0,0",
    "initialRows": 30,
    "keybindings": [
        {
            "id": "User.setColorScheme.10000000",
            "keys": "alt+1"
        },
        {
            "id": "User.setColorScheme.10000001",
            "keys": "alt+2"
        },
        {
            "id": "User.setColorScheme.10000002",
            "keys": "alt+3"
        },
        {
            "id": "User.setColorScheme.10000003",
            "keys": "alt+4"
        },
        {
            "id": "User.setColorScheme.10000004",
            "keys": "alt+5"
        },
        {
            "id": "User.setColorScheme.10000005",
            "keys": "alt+6"
        },
        {
            "id": "User.newTab",
            "keys": "ctrl+enter"
        },
        {
            "id": "User.newTab.10000006",
            "keys": "ctrl+1"
        },
        {
            "id": "User.newTab.10000007",
            "keys": "ctrl+2"
        },
        {
            "id": "User.newTab.10000008",
            "keys": "ctrl+3"
        },
        {
            "id": "User.closeTab",
            "keys": "ctrl+w"
        },
        {
            "id": "User.closeWindow",
            "keys": "ctrl+q"
        },
        {
            "id": "User.splitPane.10000009",
            "keys": "ctrl+shift+enter"
        },
        {
            "id": "User.splitPane.1000000A",
            "keys": "ctrl+shift+z"
        },
        {
            "id": "User.splitPane.1000000B",
            "keys": "ctrl+shift+x"
        },
        {
            "id": "User.closePane",
            "keys": "ctrl+shift+w"
        },
        {
            "id": "User.openSettings.1000000C",
            "keys": "ctrl+shift+comma"
        },
        // End of action keybinds
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+tab"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "ctrl+shift+tab"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "alt+left"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "alt+h"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "alt+down"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "alt+j"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "alt+up"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "alt+k"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "alt+right"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "alt+l"
        },
        {
            "id": "Terminal.ResizePaneLeft",
            "keys": "alt+shift+left"
        },
        {
            "id": "Terminal.ResizePaneLeft",
            "keys": "alt+shift+h"
        },
        {
            "id": "Terminal.ResizePaneDown",
            "keys": "alt+shift+down"
        },
        {
            "id": "Terminal.ResizePaneDown",
            "keys": "alt+shift+j"
        },
        {
            "id": "Terminal.ResizePaneUp",
            "keys": "alt+shift+up"
        },
        {
            "id": "Terminal.ResizePaneUp",
            "keys": "alt+shift+k"
        },
        {
            "id": "Terminal.ResizePaneRight",
            "keys": "alt+shift+right"
        },
        {
            "id": "Terminal.ResizePaneRight",
            "keys": "alt+shift+l"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+shift+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+shift+v"
        },
        {
            "id": "Terminal.ToggleFullscreen",
            "keys": "alt+f"
        },
        {
            "id": "Terminal.ToggleFullscreen",
            "keys": "f11"
        }
    ],
    "newTabMenu": [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": {
        "defaults": {
            "antialiasingMode": "cleartype",
            "bellStyle": [
